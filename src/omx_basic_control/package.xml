<?xml version="1.0"?>
<package format="3">
  <name>omx_basic_control</name>
  <version>0.0.1</version>
  <description>Basic node that moves the OpenManipulator-X arm and gripper</description>
  <maintainer email="greafdorothy@yandex.com">Igor Saprygin</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <depend>omx_interfaces</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
